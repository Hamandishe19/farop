# Farop Clothing — settings template. Copy to .env.local and fill in.
#
# Fill in the three Supabase values from your Supabase project:
#   Project Settings → API (or "Data API" / "API Keys")
# then restart the dev server (stop it and run `npm run dev` again).
#
# On the live site, add the same values in your host's settings instead
# (e.g. Vercel → Project → Settings → Environment Variables) and redeploy.

# ---------------------------------------------------------------------------
# Supabase (database, admin sign-in, photos)
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" key (safe to be public — security rules protect the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" / "secret" key — SERVER ONLY, never share it, never add NEXT_PUBLIC_.
# Needed for the Team page (adding/removing admins, resetting passwords).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional — leave commented out to use the defaults built into the site
# ---------------------------------------------------------------------------

# Public address of the live site (added to product links in WhatsApp enquiries).
# Detected automatically on Vercel.
# NEXT_PUBLIC_SITE_URL=https://faropclothing.com

# Override the WhatsApp number / Facebook page (normally set in Admin → Settings).
# NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=+263 77 477 3122
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61595037514699

# Currency prices are shown in (default USD).
# NEXT_PUBLIC_CURRENCY=USD
